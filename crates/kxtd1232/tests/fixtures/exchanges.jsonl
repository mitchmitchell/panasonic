{"step": 0, "dir": "pc", "kind": "text", "data": "\\r\\n", "note": "once, shortly after the PBX's XON"}
{"step": 1, "dir": "pbx", "kind": "text", "data": "<SIGNON_BANNER>\\r\\nPassword:\\r\\n", "note": "banner placeholder; the PBX sends XOFF then XON before it"}
{"step": 2, "dir": "pc", "kind": "text", "data": "<PASSWORD>\\r\\n", "note": "placeholder; the real value is the unit's real default and is not recorded here"}
{"step": 3, "dir": "pbx", "kind": "text", "data": "<MODE_START>\\r\\n", "note": ""}
{"step": 4, "dir": "pc", "kind": "text", "data": "ECS OF\\r\\n", "note": ""}
{"step": 5, "dir": "pbx", "kind": "text", "data": "ECS OF\\r\\nOK\\r\\n", "note": "echo then OK"}
{"step": 6, "dir": "pc", "kind": "text", "data": "PRG\\r\\n", "note": ""}
{"step": 7, "dir": "pbx", "kind": "text", "data": "OK\\r\\n", "note": "binary mode from here"}
{"step": 8, "dir": "pc", "kind": "hex", "data": "03 08 00 0b", "note": "version/status probe"}
{"step": 9, "dir": "pbx", "kind": "hex", "data": "<20-byte reply, content omitted: carries the unit's ROM id>", "note": "LEN 0x13"}
{"step": 10, "dir": "pc", "kind": "hex", "data": "03 08 01 0c", "note": "second probe"}
{"step": 11, "dir": "pbx", "kind": "hex", "data": "04 08 01 03 10", "note": "refusal; DSHSOMT sends this probe 5 times"}
{"step": 12, "dir": "pc", "kind": "hex", "data": "08 01 06 00 00 00 00 03 12", "note": "read table 0x06 rec 0 word 0, NN=3 words"}
{"step": 13, "dir": "pbx", "kind": "hex", "data": "09 01 00 01 02 03 04 05 06 1f", "note": "synthetic 6-byte payload 01..06"}
{"step": 14, "dir": "pc", "kind": "hex", "data": "08 01 06 00 00 00 00 03 13", "note": "same read, checksum +1"}
{"step": 15, "dir": "pbx", "kind": "hex", "data": "04 01 01 02 08", "note": "read bad-checksum NAK"}
{"step": 16, "dir": "pc", "kind": "hex", "data": "08 01 40 00 01 00 00 01 4b", "note": "read table 0x40 past its first-cabinet half"}
{"step": 17, "dir": "pbx", "kind": "hex", "data": "04 01 01 03 09", "note": "end-of-table refusal; DSHSOMT retries 5x then moves on"}
{"step": 18, "dir": "pc", "kind": "hex", "data": "0e 00 06 00 00 00 00 00 01 02 03 04 05 06 29", "note": "write table 0x06 rec 0 word 0, synthetic payload, LEN = 8 + payload"}
{"step": 19, "dir": "pbx", "kind": "hex", "data": "03 00 00 03", "note": "write ack (real latency 0.114-0.589 s)"}
{"step": 20, "dir": "pc", "kind": "hex", "data": "0e 00 06 00 00 00 00 00 01 02 03 04 05 06 2a", "note": "same write, checksum +1"}
{"step": 21, "dir": "pbx", "kind": "hex", "data": "04 00 01 02 07", "note": "write bad-checksum NAK (~0.287 s); link survives, data unchanged"}
{"step": 22, "dir": "pc", "kind": "hex", "data": "02 0a 0c", "note": "end-of-upload frame 1 (meaning unknown)"}
{"step": 23, "dir": "pc", "kind": "hex", "data": "02 10 12", "note": "end-of-upload frame 2, sent without waiting"}
{"step": 24, "dir": "pbx", "kind": "hex", "data": "03 0a 00 0d", "note": ""}
{"step": 25, "dir": "pbx", "kind": "hex", "data": "03 10 00 13", "note": ""}
{"step": 26, "dir": "pc", "kind": "hex", "data": "02 0b 0d", "note": "end binary"}
{"step": 27, "dir": "pbx", "kind": "hex", "data": "03 0b 00 0e", "note": ""}
{"step": 28, "dir": "pc", "kind": "text", "data": "BYE\\r\\n", "note": ""}
{"step": 29, "dir": "pbx", "kind": "text", "data": "OK\\r\\n", "note": "followed by the banner again"}
